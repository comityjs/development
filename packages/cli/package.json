{
  "name": "@comity-dev/cli",
  "version": "0.1.0",
  "description": "Comity unified developer CLI. Development tooling.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "comity": {
    "layer": "dev-tooling"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "comity": "./dist/bin/comity.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@comity-dev/build": "workspace:*",
    "@comity-dev/package-tools": "workspace:*",
    "@comity-dev/validate": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}