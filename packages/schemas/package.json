{
  "name": "@comity-dev/schemas",
  "version": "0.3.0",
  "description": "Reusable JSON Schema definitions for Comity package metadata, ADR-008 register, and repository configuration. Development tooling.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "comity": {
    "layer": "dev-tooling"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/comityjs/development.git",
    "directory": "packages/schemas"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-adr-008.mjs",
    "build": "node scripts/generate-adr-008.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
